# IntelliJ IDEA
.idea/
*.iml

# 환경변수 파일 (비밀 값). 예시 파일 .env.example 만 저장소에 올린다
.env
.env.*
!.env.example

# 사용자 업로드 파일 (FileStorageService, file.upload-dir)
uploads/
# 단, 시연용 샘플 영상(moneybeetle/uploads/videos, 시드 lesson.video_url)은 저장소에 둔다 (#73)
!moneybeetle/uploads/
moneybeetle/uploads/*
!moneybeetle/uploads/videos/
